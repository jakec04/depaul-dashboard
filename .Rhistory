# Quick DePaul vs peer mean table for a few headline metrics
headline_vars <- c(
"Tuition_pct_rev",
"InvReturn_pct_rev",
"Instruction_pct_exp",
"InstSupport_pct_exp"
)
headline_labels <- c(
Tuition_pct_rev       = "Tuition % of core revenue",
InvReturn_pct_rev     = "Investment return % of core revenue",
Instruction_pct_exp   = "Instruction % of core expenses",
InstSupport_pct_exp   = "Institutional support % of core expenses"
)
depaul_headline <- depaul %>%
select(School, all_of(headline_vars)) %>%
pivot_longer(cols = all_of(headline_vars),
names_to = "Metric",
values_to = "DePaul")
peer_headline <- peers %>%
select(School, all_of(headline_vars)) %>%
pivot_longer(cols = all_of(headline_vars),
names_to = "Metric",
values_to = "Value") %>%
group_by(Metric) %>%
summarise(Peer_Avg = mean(Value, na.rm = TRUE), .groups = "drop")
headline_compare <- depaul_headline %>%
left_join(peer_headline, by = "Metric") %>%
mutate(Metric_Label = recode(Metric, !!!headline_labels))
headline_compare
