library(dplyr)
library(readr)
library(tidyr)
library(ggplot2)
library(stringr)
# ---- LOAD DATA ----
# depaul_peer_wide_metrics.csv should have:
# School (chr), Type (chr), and 24 numeric columns.
peer_wide <- read_csv("depaul_peer_wide_metrics.csv", show_col_types = FALSE)
# Make sure column types are what we expect
peer_wide <- peer_wide %>%
mutate(
School = as.character(School),
Type   = factor(Type)
)
# Split DePaul vs peers
depaul <- peer_wide %>% filter(School == "DePaul University")
peers  <- peer_wide %>% filter(School != "DePaul University")
library(dplyr)
library(readr)
library(tidyr)
library(ggplot2)
library(stringr)
# ---- LOAD DATA ----
# depaul_peer_wide_metrics.csv should have:
# School (chr), Type (chr), and 24 numeric columns.
peer_wide <- read_csv("depaul_peer_wide_metrics.csv", show_col_types = FALSE)
# Make sure column types are what we expect
peer_wide <- peer_wide %>%
mutate(
School = as.character(School),
Type   = factor(Type)
)
# Split DePaul vs peers
depaul <- peer_wide %>% filter(School == "DePaul University")
peers  <- peer_wide %>% filter(School != "DePaul University")
# The above made School numeric; replace with rownames from original if needed.
# If your CSV already has a School column, replace the block above with:
# peer_wide <- read_csv("depaul_peer_wide_metrics.csv")
# and ensure there's a School column present.
# For the version we built earlier, index is actually the rownames.
# Let's reload more robustly:
peer_wide <- read_csv("depaul_peer_wide_metrics.csv")
# In that file, "School" is the index name we set.
# If it's not present, reconstruct from rownames; otherwise trust the column.
if (!"School" %in% names(peer_wide)) {
stop("Expected a 'School' column in depaul_peer_wide_metrics.csv")
}
# Ensure Type is a factor
peer_wide <- peer_wide %>%
mutate(
Type = factor(Type),
School = as.character(School)
)
# Split DePaul vs peers
depaul <- peer_wide %>% filter(School == "DePaul University")
peers  <- peer_wide %>% filter(School != "DePaul University")
depaul_overview <- depaul %>%
select(
School, Type,
Tuition_pct_rev,
GovGrants_pct_rev,
PrivateGifts_pct_rev,
InvReturn_pct_rev,
Other_pct_rev,
Instruction_pct_exp,
InstSupport_pct_exp
)
depaul_overview
# Long format for revenue % metrics
rev_vars <- c(
"Tuition_pct_rev",
"GovGrants_pct_rev",
"PrivateGifts_pct_rev",
"InvReturn_pct_rev",
"Other_pct_rev"
)
rev_labels <- c(
Tuition_pct_rev       = "Tuition & fees",
GovGrants_pct_rev     = "Government grants",
PrivateGifts_pct_rev  = "Private gifts",
InvReturn_pct_rev     = "Investment return",
Other_pct_rev         = "Other core revenue"
)
# Peer averages
peer_rev_avg <- peers %>%
select(School, Type, all_of(rev_vars)) %>%
pivot_longer(cols = all_of(rev_vars),
names_to = "Metric",
values_to = "Value") %>%
group_by(Metric) %>%
summarise(Peer_Avg = mean(Value, na.rm = TRUE), .groups = "drop")
# DePaul
depaul_rev <- depaul %>%
select(School, all_of(rev_vars)) %>%
pivot_longer(cols = all_of(rev_vars),
names_to = "Metric",
values_to = "DePaul_Value")
# Join
rev_compare <- depaul_rev %>%
left_join(peer_rev_avg, by = "Metric") %>%
mutate(Metric_Label = recode(Metric, !!!rev_labels))
rev_compare
rev_plot_data <- rev_compare %>%
pivot_longer(cols = c("DePaul_Value", "Peer_Avg"),
names_to = "Group",
values_to = "Value") %>%
mutate(
Group = recode(Group,
DePaul_Value = "DePaul",
Peer_Avg = "Peer Average")
)
ggplot(rev_plot_data,
aes(x = Metric_Label, y = Value, fill = Group)) +
geom_col(position = position_dodge(width = 0.7)) +
coord_flip() +
labs(
x = NULL,
y = "Percent of core revenue",
fill = NULL,
title = "Revenue mix: DePaul vs peer average"
) +
scale_y_continuous(labels = scales::percent_format(scale = 1)) +
theme_minimal()
# Long format for expense % metrics
exp_vars <- c(
"Instruction_pct_exp",
"Research_pct_exp",
"PublicService_pct_exp",
"AcadSupport_pct_exp",
"StudServices_pct_exp",
"InstSupport_pct_exp",
"Other_pct_exp"
)
exp_labels <- c(
Instruction_pct_exp   = "Instruction",
Research_pct_exp      = "Research",
PublicService_pct_exp = "Public service",
AcadSupport_pct_exp   = "Academic support",
StudServices_pct_exp  = "Student services",
InstSupport_pct_exp   = "Institutional support (admin)",
Other_pct_exp         = "Other core expenses"
)
peer_exp_avg <- peers %>%
select(School, Type, all_of(exp_vars)) %>%
pivot_longer(cols = all_of(exp_vars),
names_to = "Metric",
values_to = "Value") %>%
group_by(Metric) %>%
summarise(Peer_Avg = mean(Value, na.rm = TRUE), .groups = "drop")
depaul_exp <- depaul %>%
select(School, all_of(exp_vars)) %>%
pivot_longer(cols = all_of(exp_vars),
names_to = "Metric",
values_to = "DePaul_Value")
exp_compare <- depaul_exp %>%
left_join(peer_exp_avg, by = "Metric") %>%
mutate(Metric_Label = recode(Metric, !!!exp_labels))
exp_compare
exp_plot_data <- exp_compare %>%
pivot_longer(cols = c("DePaul_Value", "Peer_Avg"),
names_to = "Group",
values_to = "Value") %>%
mutate(
Group = recode(Group,
DePaul_Value = "DePaul",
Peer_Avg = "Peer Average")
)
ggplot(exp_plot_data,
aes(x = Metric_Label, y = Value, fill = Group)) +
geom_col(position = position_dodge(width = 0.7)) +
coord_flip() +
labs(
x = NULL,
y = "Percent of core expenses",
fill = NULL,
title = "Expense mix: DePaul vs peer average"
) +
scale_y_continuous(labels = scales::percent_format(scale = 1)) +
theme_minimal()
revft_vars <- c(
"Tuition_rev_perFTE",
