### {width="25%"}

```{r}
#| content: valuebox
#| title: "vs. Median"
diff_from_median <- depaul_tuition - median_tuition
pct_diff <- round(((depaul_tuition - median_tuition) / median_tuition) * 100, 1)
list(
  icon = if(pct_diff < 0) "arrow-down" else "arrow-up",
  color = if(pct_diff < 0) "success" else "warning",
  value = paste0("$", format(abs(diff_from_median), big.mark=","), " (", pct_diff, "%)")
)
```

