```{r}
#| title: "DePaul vs. Peer Institutions (Top & Bottom)"

# Select top and bottom institutions plus DePaul
top_n <- 6
bottom_n <- 6
top_indices <- 1:min(top_n, nrow(tuition_data))
bottom_indices <- max(1, nrow(tuition_data) - bottom_n + 1):nrow(tuition_data)
depaul_index <- which(tuition_data$is_depaul)
display_indices <- sort(unique(c(top_indices, bottom_indices, depaul_index)))

display_data <- tuition_data[display_indices, ]

# Create interactive plotly chart
fig <- plot_ly(
  data = display_data,
  y = ~reorder(institution_clean, tuition),
  x = ~tuition,
  type = 'bar',
  orientation = 'h',
  marker = list(color = ~color),
  text = ~paste0("$", format(tuition, big.mark=",")),
  textposition = 'outside',
  hovertemplate = paste(
    '<b>%{y}</b><br>',
    'Tuition: $%{x:,.0f}<br>',
    'Rank: %{customdata}',
    '<extra></extra>'
  ),
  customdata = ~rank
) %>%
  layout(
    xaxis = list(
      title = "Annual Tuition & Fees ($)",
      tickformat = "$,.0f"
    ),
    yaxis = list(
      title = ""
    ),
    showlegend = FALSE,
    margin = list(l = 150, r = 50, t = 30, b = 50),
    annotations = list(
      list(
        text = "Source: IPEDS • Academic Year 2024-25",
        xref = "paper",
        yref = "paper",
        x = 1,
        y = -0.1,
        showarrow = FALSE,
        font = list(size = 10, color = "gray")
      )
    )
  ) %>%
  config(displayModeBar = TRUE)

fig
