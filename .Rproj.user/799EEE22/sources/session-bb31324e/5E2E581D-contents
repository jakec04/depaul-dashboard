```{r load-tuition-data}
# TUITION DATA
csv_path_tuition <- "/Users/jakecox/Downloads/compare-institutions-2025-11-21-17-50.xlsx - Student Charges.csv"

header_row <- read.csv(csv_path_tuition,
                      skip = 3, nrows = 1, header = FALSE, stringsAsFactors = FALSE)

institutions <- as.character(header_row[1, 4:ncol(header_row)])
institutions <- institutions[institutions != ""]

data <- read.csv(csv_path_tuition, 
                skip = 4, header = FALSE, stringsAsFactors = FALSE)

tuition_values <- as.numeric(data[24, 4:ncol(data)])

if(length(tuition_values) > length(institutions)) {
  tuition_values <- tuition_values[1:length(institutions)]
}

tuition_data <- data.frame(
  institution = institutions,
  tuition = tuition_values,
  stringsAsFactors = FALSE
)

tuition_data <- tuition_data[!is.na(tuition_data$tuition), ]
tuition_data$is_depaul <- grepl("DePaul", tuition_data$institution, ignore.case = TRUE)

tuition_data <- tuition_data[order(tuition_data$tuition), ]
tuition_data$rank <- 1:nrow(tuition_data)

tuition_data$institution_clean <- gsub("\\.", " ", tuition_data$institution)

depaul_rank_tuition <- tuition_data$rank[tuition_data$is_depaul]
depaul_tuition <- tuition_data$tuition[tuition_data$is_depaul]
depaul_percentile_tuition <- round((depaul_rank_tuition / nrow(tuition_data)) * 100)

median_tuition <- median(tuition_data$tuition)
min_tuition <- min(tuition_data$tuition)
max_tuition <- max(tuition_data$tuition)
q1_tuition <- quantile(tuition_data$tuition, 0.25)
q3_tuition <- quantile(tuition_data$tuition, 0.75)

pct_diff_tuition <- round(((depaul_tuition - median_tuition) / median_tuition) * 100, 1)

depaul_color <- "#0032A0"
peer_color <- "#8C8C8C"
tuition_data$color <- ifelse(tuition_data$is_depaul, depaul_color, peer_color)
```

```{r load-retention-data}
# RETENTION DATA
csv_path_retention <- "/Users/jakecox/rstudio/990-analysis/compare-institutions-2025-11-21-17-50.xlsx - Retention and Graduation.csv"

header_row_ret <- read.csv(csv_path_retention,
                      skip = 3, nrows = 1, header = FALSE, stringsAsFactors = FALSE)

institutions_ret <- as.character(header_row_ret[1, 4:ncol(header_row_ret)])
institutions_ret <- institutions_ret[institutions_ret != ""]

data_ret <- read.csv(csv_path_retention, 
                skip = 4, header = FALSE, stringsAsFactors = FALSE)

retention_values <- as.numeric(data_ret[1, 4:ncol(data_ret)])
grad_6yr_values <- as.numeric(data_ret[7, 4:ncol(data_ret)])
grad_4yr_values <- as.numeric(data_ret[5, 4:ncol(data_ret)])

if(length(retention_values) > length(institutions_ret)) {
  retention_values <- retention_values[1:length(institutions_ret)]
  grad_6yr_values <- grad_6yr_values[1:length(institutions_ret)]
  grad_4yr_values <- grad_4yr_values[1:length(institutions_ret)]
}

retention_data <- data.frame(
  institution = institutions_ret,
  retention = retention_values,
  grad_6yr = grad_6yr_values,
  grad_4yr = grad_4yr_values,
  stringsAsFactors = FALSE
)

retention_data <- retention_data[!is.na(retention_data$retention), ]
retention_data$is_depaul <- grepl("DePaul", retention_data$institution, ignore.case = TRUE)

retention_data <- retention_data[order(-retention_data$retention), ]
retention_data$rank <- 1:nrow(retention_data)

retention_data$institution_clean <- gsub("\\.", " ", retention_data$institution)

depaul_rank_retention <- retention_data$rank[retention_data$is_depaul]
depaul_retention <- retention_data$retention[retention_data$is_depaul]
depaul_grad_6yr <- retention_data$grad_6yr[retention_data$is_depaul]
depaul_grad_4yr <- retention_data$grad_4yr[retention_data$is_depaul]
depaul_percentile_retention <- round((depaul_rank_retention / nrow(retention_data)) * 100)

median_retention <- median(retention_data$retention)
min_retention <- min(retention_data$retention)
max_retention <- max(retention_data$retention)
median_grad_6yr <- median(retention_data$grad_6yr)

pct_diff_retention <- round(((depaul_retention - median_retention) / median_retention) * 100, 1)
pct_diff_grad <- round(((depaul_grad_6yr - median_grad_6yr) / median_grad_6yr) * 100, 1)

retention_data$color <- ifelse(retention_data$is_depaul, depaul_color, peer_color)

# Sort preference for retention chart
sort_by <- "retention"  # Change to: "retention", "grad_6yr", or "grad_4yr"
```

