## Column {width=75%}

### Row {height=100%}

```{r}
#| title: "DePaul vs. Peer Institutions"

# Select top and bottom institutions plus DePaul
top_n <- 6
bottom_n <- 6
top_indices <- 1:min(top_n, nrow(tuition_data))
bottom_indices <- max(1, nrow(tuition_data) - bottom_n + 1):nrow(tuition_data)
depaul_index <- which(tuition_data$is_depaul)
display_indices <- sort(unique(c(top_indices, bottom_indices, depaul_index)))

display_data <- tuition_data[display_indices, ]
display_colors <- bar_colors[display_indices]
display_names <- gsub("\\.", " ", display_data$institution)

par(mar=c(5, 10, 3, 2))

bp <- barplot(display_data$tuition,
        names.arg = display_names,
        horiz = TRUE,
        las = 1,
        col = display_colors,
        border = NA,
        xlab = "Annual Tuition & Fees ($)",
        cex.names = 0.8,
        cex.axis = 0.9,
        xlim = c(0, max(display_data$tuition) * 1.2))

text(display_data$tuition + max(display_data$tuition) * 0.02,
     bp,
     labels = paste0("$", format(display_data$tuition, big.mark=",", scientific=FALSE)),
     cex = 0.75,
     pos = 4)

# Add ellipsis if there's a gap
if (length(display_indices) < nrow(tuition_data)) {
  gap_start <- max(which(display_indices <= top_n))
  gap_end <- min(which(display_indices >= nrow(tuition_data) - bottom_n + 1))
  if(gap_end - gap_start > 1) {
    middle_pos <- (bp[gap_start] + bp[gap_end]) / 2
    text(max(display_data$tuition) * 0.4, middle_pos,
         labels = "⋮", cex = 2.5, col = "gray50")
  }
}

mtext("Source: IPEDS • Academic Year 2024-25", side=1, line=4, adj=1, cex=0.7, col="gray40")
```

