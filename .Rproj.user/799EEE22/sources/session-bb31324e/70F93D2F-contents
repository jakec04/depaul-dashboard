```{r load-data}
# Set the path to your CSV file
csv_path <- "/Users/jakecox/rstudio/990-analysis/compare-institutions-2025-11-21-17-50.xlsx - Retention and Graduation.csv"

# Read header row to get institution names
header_row <- read.csv(csv_path,
                      skip = 3, nrows = 1, header = FALSE, stringsAsFactors = FALSE)

# Get institution names (starting from column 4)
institutions <- as.character(header_row[1, 4:ncol(header_row)])
institutions <- institutions[institutions != ""]

# Read the data
data <- read.csv(csv_path, 
                skip = 4, header = FALSE, stringsAsFactors = FALSE)

# Extract key metrics
# Row 5: First to second year retention rates (Full-time, Fall 2022)
retention_values <- as.numeric(data[1, 4:ncol(data)])

# Row 11: 6-year graduation rate (2017 cohort)
grad_6yr_values <- as.numeric(data[7, 4:ncol(data)])

# Row 9: 4-year graduation rate (2017 cohort) 
grad_4yr_values <- as.numeric(data[5, 4:ncol(data)])

# Trim to match institutions length
if(length(retention_values) > length(institutions)) {
  retention_values <- retention_values[1:length(institutions)]
  grad_6yr_values <- grad_6yr_values[1:length(institutions)]
  grad_4yr_values <- grad_4yr_values[1:length(institutions)]
}

# Create datasets
retention_data <- data.frame(
  institution = institutions,
  retention = retention_values,
  grad_6yr = grad_6yr_values,
  grad_4yr = grad_4yr_values,
  stringsAsFactors = FALSE
)

# Remove NA values
retention_data <- retention_data[!is.na(retention_data$retention), ]
retention_data$is_depaul <- grepl("DePaul", retention_data$institution, ignore.case = TRUE)

# Sort by retention rate DESCENDING (higher is better!)
retention_data <- retention_data[order(-retention_data$retention), ]
retention_data$rank <- 1:nrow(retention_data)

# Clean institution names
retention_data$institution_clean <- gsub("\\.", " ", retention_data$institution)

# Get DePaul's information
depaul_rank <- retention_data$rank[retention_data$is_depaul]
depaul_retention <- retention_data$retention[retention_data$is_depaul]
depaul_grad_6yr <- retention_data$grad_6yr[retention_data$is_depaul]
depaul_grad_4yr <- retention_data$grad_4yr[retention_data$is_depaul]
depaul_percentile <- round((depaul_rank / nrow(retention_data)) * 100)

# Summary statistics
median_retention <- median(retention_data$retention)
min_retention <- min(retention_data$retention)
max_retention <- max(retention_data$retention)
median_grad_6yr <- median(retention_data$grad_6yr)

# Calculate percentage difference
pct_diff_retention <- round(((depaul_retention - median_retention) / median_retention) * 100, 1)
pct_diff_grad <- round(((depaul_grad_6yr - median_grad_6yr) / median_grad_6yr) * 100, 1)

# Colors
depaul_color <- "#0032A0"
peer_color <- "#8C8C8C"
retention_data$color <- ifelse(retention_data$is_depaul, depaul_color, peer_color)
```

