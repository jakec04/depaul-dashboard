```{r}
#| title: "DePaul vs. 25 Peer Institutions - Undergraduate Tuition (2024-25)"
#| padding: 0px

# Reverse order for display (highest at top)
tuition_data_display <- tuition_data[nrow(tuition_data):1, ]

# Create interactive plotly chart for all institutions
fig <- plot_ly(
  data = tuition_data_display,
  y = ~institution_clean,
  x = ~tuition,
  type = 'bar',
  orientation = 'h',
  marker = list(color = ~color),
  text = ~paste0("$", format(tuition, big.mark=",")),
  textposition = 'outside',
  textfont = list(size = 10),
  hovertemplate = paste(
    '<b>%{y}</b><br>',
    'Tuition: <b>$%{x:,.0f}</b><br>',
    'Affordability Rank: <b>%{customdata[0]} of ', nrow(tuition_data), '</b><br>',
    '(Lower rank = more affordable)',
    '<extra></extra>'
  ),
  customdata = ~cbind(rank)
) %>%
  layout(
    xaxis = list(
      title = "Annual Tuition & Fees ($)",
      tickformat = "$,.0f",
      showgrid = TRUE,
      gridcolor = "#f0f0f0"
    ),
    yaxis = list(
      title = "",
      categoryorder = "array",
      categoryarray = ~institution_clean
    ),
    showlegend = FALSE,
    margin = list(l = 150, r = 80, t = 10, b = 50),
    plot_bgcolor = "white",
    paper_bgcolor = "white"
  ) %>%
  config(displayModeBar = TRUE, displaylogo = FALSE)

fig
```

