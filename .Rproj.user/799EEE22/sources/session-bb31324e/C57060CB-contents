```{r load-tuition-data}
# TUITION DATA
csv_path_tuition <- "/Users/jakecox/Downloads/compare-institutions-2025-11-21-17-50.xlsx - Student Charges.csv"

header_row <- read.csv(csv_path_tuition,
                      skip = 3, nrows = 1, header = FALSE, stringsAsFactors = FALSE)

institutions <- as.character(header_row[1, 4:ncol(header_row)])
institutions <- institutions[institutions != ""]

data <- read.csv(csv_path_tuition, 
                skip = 4, header = FALSE, stringsAsFactors = FALSE)

tuition_values <- as.numeric(data[24, 4:ncol(data)])

if(length(tuition_values) > length(institutions)) {
  tuition_values <- tuition_values[1:length(institutions)]
}

tuition_data <- data.frame(
  institution = institutions,
  tuition = tuition_values,
  stringsAsFactors = FALSE
)

tuition_data <- tuition_data[!is.na(tuition_data$tuition), ]
tuition_data$is_depaul <- grepl("DePaul", tuition_data$institution, ignore.case = TRUE)

tuition_data <- tuition_data[order(tuition_data$tuition), ]
tuition_data$rank <- 1:nrow(tuition_data)

tuition_data$institution_clean <- gsub("\\.", " ", tuition_data$institution)

depaul_rank_tuition <- tuition_data$rank[tuition_data$is_depaul]
depaul_tuition <- tuition_data$tuition[tuition_data$is_depaul]
depaul_percentile_tuition <- round((depaul_rank_tuition / nrow(tuition_data)) * 100)

median_tuition <- median(tuition_data$tuition)
min_tuition <- min(tuition_data$tuition)
max_tuition <- max(tuition_data$tuition)
q1_tuition <- quantile(tuition_data$tuition, 0.25)
q3_tuition <- quantile(tuition_data$tuition, 0.75)

pct_diff_tuition <- round(((depaul_tuition - median_tuition) / median_tuition) * 100, 1)

depaul_color <- "#0032A0"
peer_color <- "#8C8C8C"
tuition_data$color <- ifelse(tuition_data$is_depaul, depaul_color, peer_color)
```

