```{r load-finance-data}
# FINANCE DATA
csv_path_finance <- "/Users/jakecox/Downloads/compare-institutions-2025-11-21-17-50.xlsx - Finance (1).csv"

header_row_fin <- read.csv(csv_path_finance,
                      skip = 3, nrows = 1, header = FALSE, stringsAsFactors = FALSE)

institutions_fin <- as.character(header_row_fin[1, 4:ncol(header_row_fin)])
institutions_fin <- institutions_fin[institutions_fin != ""]

data_fin <- read.csv(csv_path_finance, 
                skip = 4, header = FALSE, stringsAsFactors = FALSE)

# Row 12: Tuition as % of revenue (FASB - private schools)
tuition_pct_revenue <- as.numeric(data_fin[8, 4:ncol(data_fin)])

# Row 24: Core revenue per FTE - Tuition and fees
revenue_per_fte <- as.numeric(data_fin[20, 4:ncol(data_fin)])

# Row 50: Core expenses per FTE - Instruction
instruction_per_fte <- as.numeric(data_fin[46, 4:ncol(data_fin)])

# Row 36: Instruction as % of expenses (FASB)
instruction_pct_expenses <- as.numeric(data_fin[32, 4:ncol(data_fin)])

if(length(tuition_pct_revenue) > length(institutions_fin)) {
  tuition_pct_revenue <- tuition_pct_revenue[1:length(institutions_fin)]
  revenue_per_fte <- revenue_per_fte[1:length(institutions_fin)]
  instruction_per_fte <- instruction_per_fte[1:length(institutions_fin)]
  instruction_pct_expenses <- instruction_pct_expenses[1:length(institutions_fin)]
}

finance_data <- data.frame(
  institution = institutions_fin,
  tuition_pct = tuition_pct_revenue,
  revenue_fte = revenue_per_fte,
  instruction_fte = instruction_per_fte,
  instruction_pct = instruction_pct_expenses,
  stringsAsFactors = FALSE
)

finance_data <- finance_data[!is.na(finance_data$tuition_pct), ]
finance_data$is_depaul <- grepl("DePaul", finance_data$institution, ignore.case = TRUE)

# Sort by instruction spending per FTE (higher is better for student investment)
finance_data <- finance_data[order(-finance_data$instruction_fte), ]
finance_data$rank <- 1:nrow(finance_data)

finance_data$institution_clean <- gsub("\\.", " ", finance_data$institution)

depaul_rank_finance <- finance_data$rank[finance_data$is_depaul]
depaul_tuition_pct <- finance_data$tuition_pct[finance_data$is_depaul]
depaul_revenue_fte <- finance_data$revenue_fte[finance_data$is_depaul]
depaul_instruction_fte <- finance_data$instruction_fte[finance_data$is_depaul]
depaul_instruction_pct <- finance_data$instruction_pct[finance_data$is_depaul]
depaul_percentile_finance <- round((depaul_rank_finance / nrow(finance_data)) * 100)

median_instruction_fte <- median(finance_data$instruction_fte)
min_instruction_fte <- min(finance_data$instruction_fte)
max_instruction_fte <- max(finance_data$instruction_fte)
median_tuition_pct <- median(finance_data$tuition_pct)

pct_diff_instruction <- round(((depaul_instruction_fte - median_instruction_fte) / median_instruction_fte) * 100, 1)

finance_data$color <- ifelse(finance_data$is_depaul, depaul_color, peer_color)
